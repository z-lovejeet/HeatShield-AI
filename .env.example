# HeatShield AI — Environment Variables Configuration
# Copy this file to .env.local for local development or add these keys in your Vercel Project Settings.

# 1. Mapbox GL JS Public Access Token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# 2. Google Gemini API Key (https://aistudio.google.com/apikey)
# Powers: /api/analyze (Gemini 3.8 Flash -> 2.5 Flash) and /api/simulate micro-briefs (Gemini 3.5 Flash Lite)
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# 3. Groq Cloud API Key (https://console.groq.com/keys)
# Powers: /api/chat (openai/gpt-oss-120b -> 20b), Street Vision (qwen/qwen3.8-27b), and /api/health-advice
GROQ_API_KEY=gsk_your_groq_api_key_here
